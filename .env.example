# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=PropAgent

# Database
MONGODB_URI=mongodb://localhost:27017/propagent

# Auth
JWT_SECRET=your-random-64-character-jwt-secret-string-here
JWT_EXPIRES_IN=7d

# AI Provider (fallback defaults — configure from admin panel after first login)
# AI_PROVIDER=openai
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
#
# Provider base URLs:
# OpenAI:     (leave AI_BASE_URL empty)
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
# Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/openai/v1
# Custom:     AI_BASE_URL=https://your-endpoint.com/v1

# Email (buyer configures their SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# File Upload
UPLOAD_DIR=public/uploads
MAX_FILE_SIZE_MB=5

# Encryption
ENCRYPTION_KEY=your-random-32-character-encryption-key-here

# ────────────────────────────────────────
# STRIPE (configure from Admin → Settings → Stripe Config)
# Get keys from: https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Webhook secret:
#   Local dev: run "stripe listen" and copy the whsec_... value
#   Production: Stripe Dashboard → Webhooks → Reveal signing secret
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Currency (ISO 4217 code: usd, eur, gbp, aud, idr, sgd)
# STRIPE_CURRENCY=usd
#
# NOTE: All Stripe config can be set from Admin → Settings → Stripe Config
# These .env values are fallback only.

# ────────────────────────────────────────
# STORAGE (configure from Admin → Settings → Storage Config)
# ────────────────────────────────────────
# STORAGE_PROVIDER=local
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=
#
# NOTE: All storage config can be set from Admin → Settings → Storage Config.
# These .env values are fallback only.
